# =========================================================================
# ROYCASH PLATFORM CONFIGURATION (.env.example)
# =========================================================================

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Admin Authentication & Security
# Session secret used for signing/authenticating sessions
ADMIN_SESSION_SECRET="your_secure_random_session_secret_change_in_prod"

# Admin Session Expiry in hours (default: 12)
ADMIN_SESSION_EXPIRY_HOURS=12

# Max login attempts before temporary lockout (default: 5)
ADMIN_MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes after exceeding max failed attempts (default: 15)
ADMIN_LOCKOUT_MINUTES=15

# Initial Admin Bootstrap (Optional)
# If provided, the backend will auto-initialize root superadmin on boot if no admin exists
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Super Administrator"

# Setup Authorization Token (Optional)
# If set, one-time initial setup via /api/admin/setup-initial will require this token
ADMIN_SETUP_TOKEN=""

# AI Studio injected secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
